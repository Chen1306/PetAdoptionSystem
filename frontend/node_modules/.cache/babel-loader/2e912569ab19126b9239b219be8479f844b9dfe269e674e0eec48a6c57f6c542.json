{"ast":null,"code":"export default {\n  name: 'PetCard',\n  props: {\n    pet: {\n      type: Object,\n      required: true\n    }\n  }\n};","map":{"version":3,"names":["name","props","pet","type","Object","required"],"sources":["src/components/pet/PetCard.vue"],"sourcesContent":["<template>\n  <div class=\"pet-card card-panel\">\n    <div class=\"pet-image\">\n      <img src=\"https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=800&q=80\" alt=\"pet\">\n    </div>\n    <div class=\"pet-content\">\n      <div class=\"pet-head\">\n        <h3>{{ pet.petName }}</h3>\n        <el-tag size=\"mini\" type=\"success\">{{ pet.type }}</el-tag>\n      </div>\n      <p class=\"meta\">年龄：{{ pet.age }} 岁 ｜ 性别：{{ pet.gender || '未知' }}</p>\n      <p class=\"desc\">{{ pet.description || '暂无描述' }}</p>\n      <el-button type=\"primary\" plain @click=\"$router.push(`/pets/${pet.id}`)\">查看详情</el-button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'PetCard',\n  props: {\n    pet: {\n      type: Object,\n      required: true\n    }\n  }\n}\n</script>\n\n<style scoped>\n.pet-card {\n  overflow: hidden;\n}\n\n.pet-image img {\n  width: 100%;\n  height: 220px;\n  object-fit: cover;\n  display: block;\n}\n\n.pet-content {\n  padding: 18px;\n}\n\n.pet-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n}\n\n.pet-head h3 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.meta {\n  color: var(--text-sub);\n  margin: 10px 0;\n}\n\n.desc {\n  min-height: 44px;\n  color: #374151;\n  line-height: 1.6;\n}\n</style>\n"],"mappings":"AAkBA;EACAA,IAAA;EACAC,KAAA;IACAC,GAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,QAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}