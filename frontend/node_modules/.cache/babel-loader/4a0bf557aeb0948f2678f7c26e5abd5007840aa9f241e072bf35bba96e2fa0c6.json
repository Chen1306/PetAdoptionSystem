{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { clearAuth } from '../../utils/auth';\nexport default {\n  name: 'AdminLayout',\n  methods: {\n    logout: function logout() {\n      clearAuth();\n      this.$message.success('已退出登录');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["clearAuth","name","methods","logout","$message","success","$router","push"],"sources":["src/components/layout/AdminLayout.vue"],"sourcesContent":["<template>\n  <div class=\"admin-layout\">\n    <aside class=\"sidebar\">\n      <div class=\"sidebar-title\">后台管理</div>\n      <el-menu :default-active=\"$route.path\" router>\n        <el-menu-item index=\"/admin\">控制台</el-menu-item>\n        <el-menu-item index=\"/admin/users\">用户管理</el-menu-item>\n        <el-menu-item index=\"/admin/pets\">宠物管理</el-menu-item>\n        <el-menu-item index=\"/admin/adoptions\">领养审核</el-menu-item>\n      </el-menu>\n    </aside>\n    <main class=\"main-area\">\n      <div class=\"admin-topbar\">\n        <div>\n          <div class=\"admin-title\">流浪动物管理及领养系统</div>\n          <div class=\"admin-subtitle\">管理员工作台</div>\n        </div>\n        <div class=\"topbar-actions\">\n          <el-button size=\"mini\" @click=\"$router.push('/pets')\">前台首页</el-button>\n          <el-button type=\"danger\" size=\"mini\" plain @click=\"logout\">退出</el-button>\n        </div>\n      </div>\n      <div class=\"admin-content\">\n        <router-view />\n      </div>\n    </main>\n  </div>\n</template>\n\n<script>\nimport { clearAuth } from '../../utils/auth'\n\nexport default {\n  name: 'AdminLayout',\n  methods: {\n    logout() {\n      clearAuth()\n      this.$message.success('已退出登录')\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.admin-layout {\n  display: flex;\n  min-height: 100vh;\n  background: #f3f6f8;\n}\n\n.sidebar {\n  width: 240px;\n  background: linear-gradient(180deg, #21543b 0%, #173f2c 100%);\n  color: #fff;\n  padding: 24px 0;\n}\n\n.sidebar-title {\n  padding: 0 24px 18px;\n  font-size: 22px;\n  font-weight: 800;\n}\n\n.sidebar ::v-deep .el-menu {\n  border-right: none;\n  background: transparent;\n}\n\n.sidebar ::v-deep .el-menu-item {\n  color: rgba(255, 255, 255, 0.84);\n}\n\n.sidebar ::v-deep .el-menu-item.is-active {\n  color: #fff;\n  background: rgba(255, 255, 255, 0.12);\n}\n\n.main-area {\n  flex: 1;\n  padding: 24px;\n}\n\n.admin-topbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.admin-title {\n  font-size: 28px;\n  font-weight: 800;\n}\n\n.admin-subtitle {\n  margin-top: 6px;\n  color: var(--text-sub);\n}\n\n.topbar-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.admin-content {\n  min-height: calc(100vh - 120px);\n}\n</style>\n"],"mappings":";AA8BA,SAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MACAH,SAAA;MACA,KAAAI,QAAA,CAAAC,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}