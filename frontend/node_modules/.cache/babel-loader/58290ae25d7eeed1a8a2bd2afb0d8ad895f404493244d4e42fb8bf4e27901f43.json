rcesContent":["<template>\n  <div>\n    <app-header />\n    <section class=\"hero\">\n      <div class=\"page-container hero-inner\">\n        <div>\n          <div class=\"hero-kicker\">救助 · 领养 · 陪伴</div>\n          <h1>为每一只等待家的动物，找到认真生活的人</h1>\n          <p>浏览已通过审核的宠物信息，提交领养申请，跟进审核进度。</p>\n        </div>\n      </div>\n    </section>\n    <main class=\"page-container main-area\">\n      <div class=\"filter-bar card-panel\">\n        <el-input v-model=\"query.keyword\" placeholder=\"搜索宠物名称或描述\" clearable />\n        <el-select v-model=\"query.type\" placeholder=\"宠物类型\" clearable>\n          <el-option label=\"猫\" value=\"cat\" />\n          <el-option label=\"狗\" value=\"dog\" />\n          <el-option label=\"其他\" value=\"other\" />\n        </el-select>\n        <el-button type=\"primary\" @click=\"fetchPets\">查询</el-button>\n        <el-button @click=\"reset\">重置</el-button>\n      </div>\n      <div v-loading=\"loading\" class=\"pet-grid\">\n        <pet-card v-for=\"pet in pets\" :key=\"pet.id\" :pet=\"pet\" />\n      </div>\n      <div v-if=\"!loading && !pets.length\" class=\"empty-text\">暂时没有符合条件的宠物信息</div>\n    </main>\n  </div>\n</template>\n\n<script>\nimport { getPetList } from '../../api/pet'\nimport AppHeader from '../../components/layout/AppHeader.vue'\nimport PetCard from '../../components/pet/PetCard.vue'\n\nexport default {\n  name: 'PetListView',\n  components: { AppHeader, PetCard },\n  data() {\n    return {\n      loading: false,\n      pets: [],\n      query: {\n        keyword: '',\n        type: ''\n      }\n    }\n  },\n  created() {\n    this.fetchPets()\n  },\n  methods: {\n    async fetchPets() {\n      this.loading = true\n      try {\n        this.pets = await getPetList(this.query)\n      } finally {\n        this.loading = false\n      }\n    },\n    reset() {\n      this.query.keyword = ''\n      this.query.type = ''\n      this.fetchPets()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.hero {\n  padding: 52px 0 24px;\n}\n\n.hero-inner {\n  background: linear-gradient(135deg, rgba(47, 133, 90, 0.94), rgba(116, 171, 115, 0.92));\n  color: #fff;\n  border-radius: 24px;\n  padding: 48px;\n}\n\n.hero-kicker {\n  font-size: 14px;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  opacity: 0.85;\n}\n\n.hero h1 {\n  margin: 12px 0 18px;\n  font-size: clamp(34px, 5vw, 54px);\n  line-height: 1.15;\n}\n\n.hero p {\n  max-width: 640px;\n  font-size: 17px;\n  line-height: 1.8;\n}\n\n.main-area {\n  padding: 20px 0 40px;\n}\n\n.filter-bar {\n  display: grid;\n  grid-template-columns: 1.7fr 1fr auto auto;\n  gap: 14px;\n  padding: 20px;\n  margin-bottom: 24px;\n}\n\n.pet-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 20px;\n}\n</style>\n"],"mappings":";;AAgCA,SAAAA,UAAA;AACA,OAAAC,SAAA;AACA,OAAAC,OAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,SAAA,EAAAA,SAAA;IAAAC,OAAA,EAAAA;EAAA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACAD,SAAA,WAAAA,UAAA;MAAA,IAAAE,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,OAAAF,YAAA,GAAAG,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAR,KAAA,CAAAR,OAAA;cAAAc,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAtB,UAAA,CAAAc,KAAA,CAAAN,KAAA;YAAA;cAAAM,KAAA,CAAAP,IAAA,GAAAa,QAAA,CAAAG,CAAA;YAAA;cAAAH,QAAA,CAAAC,CAAA;cAEAP,KAAA,CAAAR,OAAA;cAAA,OAAAc,QAAA,CAAAI,CAAA;YAAA;cAAA,OAAAJ,QAAA,CAAAK,CAAA;UAAA;QAAA,GAAAP,OAAA;MAAA;IAEA;IACAQ,KAAA,WAAAA,MAAA;MACA,KAAAlB,KAAA,CAAAC,OAAA;MACA,KAAAD,KAAA,CAAAE,IAAA;MACA,KAAAE,SAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}