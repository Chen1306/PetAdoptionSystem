age.success('已退出登录')\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.app-header {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  background: rgba(255, 255, 255, 0.92);\n  backdrop-filter: blur(10px);\n  border-bottom: 1px solid rgba(229, 231, 235, 0.8);\n}\n\n.header-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 72px;\n}\n\n.brand {\n  color: var(--brand-color);\n  font-size: 22px;\n  font-weight: 800;\n}\n\n.nav-links {\n  display: flex;\n  gap: 20px;\n}\n\n.nav-links a {\n  color: var(--text-main);\n  font-weight: 600;\n}\n\n.nav-links .router-link-exact-active {\n  color: var(--brand-color);\n}\n\n.actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.welcome {\n  color: var(--text-sub);\n}\n</style>\n"],"mappings":";AAmBA,SAAAA,SAAA,EAAAC,OAAA,EAAAC,QAAA,EAAAC,OAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA,EAAAJ,QAAA;MACAK,IAAA,EAAAJ,OAAA;MACAK,IAAA,EAAAP,OAAA;IACA;EACA;EACAQ,QAAA;IACAC,MAAA,WAAAA,OAAA;MACA,YAAAF,IAAA;IACA;EACA;EACAG,OAAA;IACAC,YAAA,WAAAA,aAAA;MACAZ,SAAA;MACA,KAAAa,QAAA,CAAAC,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}